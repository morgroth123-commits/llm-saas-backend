name: ChatGPT & Codex Plugin Autopilot

on:
  push:
    branches: ["**"]
    tags: ["v*"]
  pull_request:
  workflow_dispatch:
    inputs:
      action:
        description: "Autopilot mode"
        required: true
        default: auto
        type: choice
        options:
          - auto
          - analyze
          - validate
          - package
          - build-directory-pack
      create-pr:
        description: "Create a scaffold pull request when analyzing"
        required: true
        default: false
        type: boolean

permissions:
  contents: write
  pull-requests: write

concurrency:
  group: plugin-autopilot-${{ github.repository }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  autopilot:
    name: Analyze, validate, and package
    runs-on: ubuntu-latest
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository

    steps:
      - name: Check out repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Run Plugin Autopilot
        uses: imMamdouhaboammar/chatgpt-codex-plugin-autopilot@v1
        with:
          path: "."
          action: ${{ github.event_name == 'workflow_dispatch' && inputs.action || 'auto' }}
          create-pr: ${{ github.event_name == 'workflow_dispatch' && inputs.create-pr || 'false' }}
          pr-title: "🤖 [Plugin Autopilot] Scaffold ChatGPT/Codex plugin structure"
          pr-branch: "plugin-autopilot/scaffold-${{ github.run_id }}"
          output-dir: "dist"
          fail-on-error: "true"
          summary: "true"

      - name: Upload generated artifacts
        if: always() && hashFiles('dist/**') != ''
        uses: actions/upload-artifact@v4
        with:
          name: plugin-autopilot-${{ github.run_id }}
          path: dist/
          if-no-files-found: ignore
          retention-days: 30

      - name: Attach release artifacts
        if: startsWith(github.ref, 'refs/tags/v') && success()
        uses: softprops/action-gh-release@v2
        with:
          files: |
            dist/*.zip
            dist/SHA256SUMS
